# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE & BACKEND REST INTEGRATION
DATABASE_URL="postgresql://postgres:Admin2026@localhost:5432/akpbf_db"
FASTAPI_SECRET_KEY="secure-fastapi-jwt-token-or-signature-token"

# MOBILE MONEY PROVIDERS CREDENTIALS (SENEGAL/COTE D'IVOIRE)
ORANGE_MONEY_MERCHANT_ID="OM_CIV_89211_PROD"
MTN_MOMO_API_KEY="MTN_CI_SEC_2026_MOMO"
WAVE_CLIENT_SECRET="WAVE_CIV_PRE_7719"

# NOMINATIM GEOGRAPHIC USER-AGENT
NOMINATIM_USER_AGENT="akpbf-cleanup-sig-abidjan-v1"

# ZOHO MAIL SMTP CONFIGURATION
ZOHO_SMTP_HOST="smtp.zoho.com"
ZOHO_SMTP_PORT="465"
ZOHO_SMTP_USER="noreply@akpbf.com"
ZOHO_SMTP_PASS="your-zoho-app-password"
ZOHO_SMTP_SECURE="true"
ZOHO_FROM_NAME="AKPBF ERP Assainissement"

# TWILIO REAL SMS INTEGRATION CREDENTIALS
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_secret"
TWILIO_PHONE_NUMBER="+1234567890"


